# AgileMind RAG Microservice Environment Configuration
RAG_SERVICE_PORT=8000
RAG_SERVICE_TOKEN=change-me-to-a-secure-shared-secret-token

# PostgreSQL pgvector Database URL
DATABASE_URL=postgresql://levelup:levelup_secret@localhost:55432/levelup

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG Generation Configuration
LLM_MODEL=gemini-1.5-flash
TOP_K=8
TEMPERATURE=0.2
